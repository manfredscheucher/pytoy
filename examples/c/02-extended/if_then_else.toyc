// expect: 5
// steps: toycc 15, minicc 24
/*
 * if_then_else.toyc - simple if/else demonstration.
 *
 * a = 7, b = 12. Since a < b, the result is b - a = 5.
 *
 * Expected result: ACC = 5
 */
int main(void) {
    int a = 7;
    int b = 12;
    int r;
    if (a < b) {
        r = b - a;
    } else {
        r = a - b;
    }
    return r;
}

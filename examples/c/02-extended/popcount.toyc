// example: popcount
// description: Counts the set bits of 37 (100101 in binary).
// steps: toycc 120, minicc 163
// result: 3

// The Toy CPU has no %, but x & 1 equals x % 2: the least significant bit (LSB).

int popcount(int x) {
    int count = 0;
    while (x != 0) {
        count = count + (x & 1);   // add the LSB
        x = x >> 1;                // drop it
    }
    return count;
}

int main(void) {
    return popcount(37);
}

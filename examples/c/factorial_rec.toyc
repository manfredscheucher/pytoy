// expect: 120
/*
 * factorial_rec.c - n! computed RECURSIVELY.
 *
 * factorial_rec(n) = 1                          if n == 0
 *                  = n * factorial_rec(n - 1)   otherwise
 *
 * The iterative version is in factorial_iter.toyc; both compute 5! = 120.
 * toycc compiles the recursion with a self-modifying-code stack (see the
 * manual).
 *
 * Expected result: ACC = 120
 */

int factorial_rec(int n) {
    if (n == 0) {
        return 1;
    }
    return n * factorial_rec(n - 1);
}

int main(void) {
    return factorial_rec(5);
}

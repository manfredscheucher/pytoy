// expect: 120
/*
 * factorial_iter.c - n! computed ITERATIVELY.
 *
 * The recursive version is in factorial_rec.toyc; both compute 5! = 120.
 * (8-bit values wrap mod 256, so 6! = 720 would overflow.)
 *
 * Expected result: ACC = 120
 */

int factorial_iter(int n) {
    int result = 1;
    int i;
    for (i = 1; i <= n; i += 1) {
        result = result * i;
    }
    return result;
}

int main(void) {
    return factorial_iter(5);
}

// expect: 42
/*
 * multiply.c - compute a * b.
 *
 * Port of examples/asm/multiply.toys. The Toy CPU has no multiply instruction,
 * so the '*' operator is compiled to repeated addition.
 *
 * With a = 7, b = 6: result = 42.
 *
 * Expected result: ACC = 42
 */
int main(void) {
    int a = 7;
    int b = 6;
    return a * b;
}

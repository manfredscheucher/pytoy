# sevenfold.toys
# Computes res = 7 * a using doubling and addition
#
# b = a + a      (2a)
# c = b + b      (4a)
# res = a + b + c (a + 2a + 4a = 7a)
#
# With a = 4: result = 28

        load  a
        add   a
        store b         # b = 2a

        load  b
        add   b
        store c         # c = 4a

        load  a
        add   b
        add   c
        stop            # acc = a + 2a + 4a = 7a

# data
a:      4
b:      0
c:      0

# example: most significant bit (MSB), shift vs mask
# description: Extracts the MSB of x by shifting and by masking, then compares the two.
# steps: 18
# result: 0

        load  x
        right
        right
        right
        right
        right
        right
        right
        store m1          # m1 = x >> 7

        load  x
        and   mask        # isolate the MSB: 0 or 128
        ifzero zero
        load  one
        goto  done
zero:   load  zero_v
done:   store m2          # m2 = (x & 128) ? 1 : 0

        load  m1
        sub   m2
        stop              # 0 -> both agree

x:      200               # 11001000
mask:   128               # 10000000
one:    1
zero_v: 0
m1:     0
m2:     0

# load indirect: read data[i] into acc  (i=5 -> pi digit 9)
        load  base
        add   i
        store patch       # patch the LOAD address below

load:   20                # LOAD opcode
patch:  0                 # address byte -> data+i
        stop

base:   data
i:      5
data:   3
        1
        4
        1
        5
        9
        2
        6
        5
        3

# example: switch
# description: Branches on x with equality tests: 0, 1 and 2 map to themselves, else 3.
# steps: 10
# result: 2

# Equality a == b is tested as (a - b) == 0 with sub and ifzero.

        load  x
        ifzero case0      # x == 0

        load  x
        sub   one
        ifzero case1      # x == 1

        load  x
        sub   two
        ifzero case2      # x == 2

        load  three       # default
        stop
case0:  load  zero
        stop
case1:  load  one
        stop
case2:  load  two
        stop

x:      2
zero:   0
one:    1
two:    2
three:  3

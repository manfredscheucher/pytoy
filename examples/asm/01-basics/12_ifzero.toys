# IFZERO (00011001) — jump to an address only if the accumulator is zero
# x is 0, so the jump to `done` is taken and `LOAD y` is skipped; acc stays 0.

        load  x         # acc = x
        ifzero done     # x == 0 -> jump to done
        load  y         # x != 0: acc = y
done:   stop

x:      0
y:      99

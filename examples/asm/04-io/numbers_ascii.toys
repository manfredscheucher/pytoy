# numbers_ascii.toys — write 0,1,2,...,14 into the output cells io0..io14.
# Same bytes as numbers.toys, but the I/O panel opens in ascii mode. Codes 0..14
# are control characters (no visible glyph) — this file is here to show that the
# raw bytes are unchanged; only the display format differs. Switch the
# View → I/O format menu to decimal/hex/7segment to read them.
#
# pytoy: output=ascii

        load  c0
        store io0
        load  c1
        store io1
        load  c2
        store io2
        load  c3
        store io3
        load  c4
        store io4
        load  c5
        store io5
        load  c6
        store io6
        load  c7
        store io7
        load  c8
        store io8
        load  c9
        store io9
        load  c10
        store io10
        load  c11
        store io11
        load  c12
        store io12
        load  c13
        store io13
        load  c14
        store io14
        stop

# data: the constants 0..14
c0:  0
c1:  1
c2:  2
c3:  3
c4:  4
c5:  5
c6:  6
c7:  7
c8:  8
c9:  9
c10: 10
c11: 11
c12: 12
c13: 13
c14: 14

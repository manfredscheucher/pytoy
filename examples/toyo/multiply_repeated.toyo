# Toy CPU – compiled listing
#
# ADDR  BYTES                   SOURCE
# ────────────────────────────────────────────────────────
#                                # example: multiply by repeated addition
#                                # description: Computes a * b by adding a to res, b times.
#                                # steps: 60
#                                # result: 42
#                                
#                                # 255 * 255 would take 255 passes, multiply_doubling.toys at most 8.
#                                
     0   00010100  00010110              load  b
     2   00011001  00010010      loop:   ifzero done       # b == 0
     4   00010100  00010111              load  res
     6   00010110  00010101              add   a
     8   00010101  00010111              store res         # res += a
    10   00010100  00010110              load  b
    12   00010111  00011000              sub   one
    14   00010101  00010110              store b           # b--
    16   00011000  00000010              goto  loop
    18   00010100  00010111      done:   load  res
    20   00000000                        stop
#                                
    21   00000110                a:      6
    22   00000111                b:      7
    23   00000000                res:    0
    24   00000001                one:    1

# SYMBOLS
#   loop            =   2  (00000010)
#   done            =  18  (00010010)
#   a               =  21  (00010101)
#   b               =  22  (00010110)
#   res             =  23  (00010111)
#   one             =  24  (00011000)
#   io0             = 240  (11110000)
#   io1             = 241  (11110001)
#   io2             = 242  (11110010)
#   io3             = 243  (11110011)
#   io4             = 244  (11110100)
#   io5             = 245  (11110101)
#   io6             = 246  (11110110)
#   io7             = 247  (11110111)
#   io8             = 248  (11111000)
#   io9             = 249  (11111001)
#   io10            = 250  (11111010)
#   io11            = 251  (11111011)
#   io12            = 252  (11111100)
#   io13            = 253  (11111101)
#   io14            = 254  (11111110)
#   ready           = 255  (11111111)

# Toy CPU – compiled listing
#
# ADDR  BYTES                   SOURCE
# ────────────────────────────────────────────────────────
#                                # example: sum of three values
#                                # description: Adds a, b and c.
#                                # steps: 4
#                                # result: 8
#                                
#                                # Whole array: sum_array.toys.
#                                
     0   00010100  00000111              load  a
     2   00010110  00001000              add   b
     4   00010110  00001001              add   c
     6   00000000                        stop
#                                
#                                # data
     7   00000011                a:      3
     8   00000001                b:      1
     9   00000100                c:      4

# SYMBOLS
#   a               =   7  (00000111)
#   b               =   8  (00001000)
#   c               =   9  (00001001)
#   io0             = 240  (11110000)
#   io1             = 241  (11110001)
#   io2             = 242  (11110010)
#   io3             = 243  (11110011)

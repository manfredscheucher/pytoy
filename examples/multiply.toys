# multiply.toy
# Computes result = a * b using repeated addition
#
# Algorithm:
#   sum = 0
#   while a > 0:
#       sum += b
#       a -= 1
#   result = sum

        load  a         # acc = a (loop counter)
loop:   ifzero done     # a == 0 -> done
        load  sum       # acc = sum
        add   b         # acc = sum + b
        store sum       # sum += b
        load  a         # acc = a
        sub   one       # acc = a - 1
        store a         # a--
        goto  loop

done:   load  sum       # result in accumulator
        stop

# data
a:      7
b:      6
sum:    0
one:    1

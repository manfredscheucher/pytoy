// expect: 120
/*
 * factorial.c - compute n! for a small n using a for loop and '*'.
 *
 * With n = 5: 5! = 120 (fits in 8 bits). Note 6! = 720 would overflow.
 *
 * Expected result: ACC = 120
 */
int main(void) {
    int n = 5;
    int result = 1;
    int i;
    for (i = 1; i <= n; i += 1) {
        result = result * i;
    }
    return result;
}

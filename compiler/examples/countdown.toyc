// expect: 15
/*
 * countdown.c - count down from 5 and accumulate the sum 5+4+3+2+1.
 *
 * Demonstrates a while loop with a decrementing counter and +=.
 * 5 + 4 + 3 + 2 + 1 = 15.
 *
 * Expected result: ACC = 15
 */
int main(void) {
    int i = 5;
    int total = 0;
    while (i != 0) {
        total += i;
        i -= 1;
    }
    return total;
}
